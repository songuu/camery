          "minLength": 1
        },
        "movement": {
          "type": "string",
          "minLength": 1
        },
        "lens_mm": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "shot_size",
        "angle",
        "movement"
      ],
      "additionalProperties": false
    },
    "Shot": {
