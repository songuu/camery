        },
        "visual_purpose": {
          "type": "string",
          "minLength": 1
        },
        "start_state": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "end_state": {
          "type": "string",
          "minLength": 1
        },
        "camera": {
          "$ref": "#/$defs/Camera"
        },
        "asset_ref_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{1,95}$"
          },
          "uniqueItems": true
        },
        "timing": {
          "$ref": "#/$defs/Timing"
        }
      },
      "required": [
        "id",
        "scene_id",
        "sequence",
        "beat_refs",
        "visual_purpose",
        "start_state",
        "action",
        "end_state",
        "camera",
        "asset_ref_ids",
        "timing"
      ],
      "additionalProperties": false
    },
    "Panel": {
      "type": "object",
