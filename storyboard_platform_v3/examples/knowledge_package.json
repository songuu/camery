      "location_id": null,
      "character_ids": [
        "CHAR-NARRATOR"
      ],
      "script_text": "用纯音频解释普通月相来自观察角度，区分地球影子造成的月食。",
      "start_state": "听众可能把月相误解为地球阴影。",
      "end_state": "听众知道月相与月食是不同现象。",
