      "sequence": 1,
      "title": "找到便签",
      "location_id": "LOC-BOOKSHOP",
      "character_ids": [
        "CHAR-LIN",
        "CHAR-AHE",
        "CHAR-FNARRATOR"
      ],
      "script_text": "阿禾摊开地图。林澄看见父亲署名的便签，抬头说：这条路，我记得。",
      "start_state": "地图合拢，便签夹在其中。",
      "end_state": "林澄记起山路，决定前往。",
      "episode_id": "EP-FIC001"
    },
    {
      "id": "SC-F02",
      "sequence": 2,
      "title": "抵达山顶",
      "location_id": "LOC-HILL",
      "character_ids": [
        "CHAR-LIN",
        "CHAR-AHE",
        "CHAR-FNARRATOR"
      ],
      "script_text": "二人来到木长椅旁。阿禾说：我们替他看到了。林澄收起便签，望向晨光。",
      "start_state": "二人刚到观景台，林澄手持便签。",
      "end_state": "便签已收入口袋，二人并肩看远山。",
      "episode_id": "EP-FIC001"
    }
