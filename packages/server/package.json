{
  "name": "@camery/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/main.ts",
    "build": "node scripts/build.mjs",
    "start:built": "node dist/main.mjs",
    "start:worker": "node dist/worker.mjs",
    "start:worker:built": "node dist/worker.mjs",
    "start:bible-worker": "node dist/bible-worker.mjs",
    "start:development-worker": "node dist/development-worker.mjs",
    "start:outline-worker": "node dist/outline-worker.mjs",
    "test": "vitest run",
    "test:browser:outline": "vitest run --config vitest.outline-browser.config.ts",
    "test:browser:outline-adoption": "vitest run --config vitest.outline-adoption-browser.config.ts",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@camery/ir": "workspace:*",
    "@camery/versioning": "workspace:*",
    "@camery/access": "workspace:*",
    "@camery/bible": "workspace:*",
    "@camery/script": "workspace:*",
    "@camery/ingest": "workspace:*",
    "@fastify/static": "10.1.11",
    "@camery/agents": "workspace:*",
    "@camery/durable": "workspace:*",
    "@camery/methods": "workspace:*",
    "@camery/model-modes": "workspace:*",
    "@nestjs/common": "12.4.2",
    "@nestjs/core": "12.4.2",
    "@nestjs/platform-fastify": "12.4.2",
    "fastify": "5.12.8",
    "pg": "^8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^5.1.0",
    "esbuild": "0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
