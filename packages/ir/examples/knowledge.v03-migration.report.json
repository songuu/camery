    "dialogue_lines": [
      {
        "id": "LINE-K01",
        "scene_id": "SC-K01",
        "beat_id": "BEAT-K01",
        "speaker_id": "CHAR-NARRATOR",
        "kind": "narration",
        "text": "月亮看起来有时圆、有时像弯弯的月牙，这是为什么呢？",
        "delivery": "清晰、平缓；停顿计入估算窗口"
      },
      {
        "id": "LINE-K02",
        "scene_id": "SC-K01",
        "beat_id": "BEAT-K02",
        "speaker_id": "CHAR-NARRATOR",
        "kind": "narration",
        "text": "通常，太阳照亮月球的一半。月球绕地球运动时，我们看见受光部分的角度发生变化。",
        "delivery": "清晰、平缓；停顿计入估算窗口"
      },
      {
        "id": "LINE-K03",
        "scene_id": "SC-K01",
        "beat_id": "BEAT-K03",
        "speaker_id": "CHAR-NARRATOR",
        "kind": "narration",
        "text": "所以，普通月相的变化来自我们看到了受光面的不同部分；地球的影子遮到月球，对应的是月食。",
        "delivery": "清晰、平缓；停顿计入估算窗口"
      },
      {
        "id": "LINE-K04",
        "scene_id": "SC-K01",
        "beat_id": "BEAT-K04",
        "speaker_id": "CHAR-NARRATOR",
        "kind": "narration",
        "text": "记住这个区别：月相关注我们怎样看见受光面；月食关注地球影子遮挡月球。",
        "delivery": "清晰、平缓；停顿计入估算窗口"
      }
    ],
