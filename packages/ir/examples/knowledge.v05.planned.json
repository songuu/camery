  "lines": [
    {
      "id": "057WKK9MWQP5XYCYY5K5SSP57S",
      "version": 1,
      "beat_id": "0QVZA1YRHXD7HJYD7R3CN74E6P",
      "order_key": "00000001",
      "speaker_id": "7GQMWMT5YEXMGFHGJ3E23ZBQ5M",
      "kind": "narration",
      "text": "月亮看起来有时圆、有时像弯弯的月牙，这是为什么呢？",
      "delivery": "清晰、平缓；停顿计入估算窗口",
      "only_rendition_ids": [
        "45KJXZ52M5RPAFSAT2NXSW9QEQ"
      ],
      "locked": false
    },
    {
      "id": "5H1QBVV83PQ8GHMNJE5FC9A3T8",
      "version": 1,
      "beat_id": "5WB4P9X5JMEG1QZV6FBMMWMT6B",
      "order_key": "00000001",
      "speaker_id": "7GQMWMT5YEXMGFHGJ3E23ZBQ5M",
      "kind": "narration",
      "text": "通常，太阳照亮月球的一半。月球绕地球运动时，我们看见受光部分的角度发生变化。",
      "delivery": "清晰、平缓；停顿计入估算窗口",
      "only_rendition_ids": [
        "45KJXZ52M5RPAFSAT2NXSW9QEQ"
      ],
      "locked": false
    },
    {
      "id": "7GNDYCP79HCSDK8EWGKKFT5EBJ",
      "version": 1,
      "beat_id": "7ZDBDHDNE14XQRWAG36S1231NJ",
      "order_key": "00000001",
      "speaker_id": "7GQMWMT5YEXMGFHGJ3E23ZBQ5M",
      "kind": "narration",
      "text": "所以，普通月相的变化来自我们看到了受光面的不同部分；地球的影子遮到月球，对应的是月食。",
      "delivery": "清晰、平缓；停顿计入估算窗口",
      "only_rendition_ids": [
        "45KJXZ52M5RPAFSAT2NXSW9QEQ"
      ],
      "locked": false
    },
    {
      "id": "4SWKX5990FZW7B4053KETT0RXB",
      "version": 1,
      "beat_id": "6746B9GCG7GASQFNSWG37FC537",
      "order_key": "00000001",
      "speaker_id": "7GQMWMT5YEXMGFHGJ3E23ZBQ5M",
      "kind": "narration",
      "text": "记住这个区别：月相关注我们怎样看见受光面；月食关注地球影子遮挡月球。",
      "delivery": "清晰、平缓；停顿计入估算窗口",
      "only_rendition_ids": [
        "45KJXZ52M5RPAFSAT2NXSW9QEQ"
      ],
      "locked": false
    }
