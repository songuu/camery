{
  "name": "@camery/agents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "eval:check": "tsx src/node/eval-cli.ts",
    "eval:baseline": "tsx src/node/eval-cli.ts --write-baseline"
  },
  "dependencies": {
    "@camery/durable": "workspace:*",
    "@camery/methods": "workspace:*",
    "@camery/model-modes": "workspace:*",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/sdk-trace": "3.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^5.1.0",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
