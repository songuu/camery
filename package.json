{
  "name": "camery",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "lint": "pnpm lint:policy && pnpm lint:code",
    "lint:policy": "node scripts/source-policy.mjs",
    "lint:code": "oxlint --config .oxlintrc.json --deny-warnings --report-unused-disable-directives-severity error packages scripts",
    "test:tooling": "node --test scripts/*.test.mjs",
    "test": "pnpm test:tooling && node scripts/workspace.mjs test",
    "test:coverage": "pnpm test:tooling && node scripts/workspace.mjs test:coverage",
    "typecheck": "node scripts/workspace.mjs typecheck",
    "build": "node scripts/workspace.mjs build",
    "check": "pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm test:methods:evals && pnpm test:agents:evals",
    "test:agents:evals": "node scripts/workspace.mjs eval:check --filter=@camery/agents",
    "test:methods:evals": "node scripts/workspace.mjs eval:check --filter=@camery/methods",
    "test:durable:local": "node scripts/postgres-integration.mjs durable",
    "test:versioning:local": "node scripts/postgres-integration.mjs versioning",
    "test:agents:local": "node scripts/postgres-integration.mjs agents",
    "test:access:local": "node scripts/postgres-integration.mjs access",
    "start:api": "pnpm --filter @camery/server start",
    "dev:web": "pnpm --filter @camery/web dev",
    "test:server:local": "node scripts/postgres-integration.mjs server",
    "test:ingest:local": "node scripts/postgres-integration.mjs ingest",
    "test:bible:local": "node scripts/postgres-integration.mjs bible",
    "test:script:local": "node scripts/postgres-integration.mjs script",
    "test:private-api:local": "node scripts/postgres-integration.mjs private-api",
    "test:private-worker:local": "node scripts/postgres-integration.mjs private-worker",
    "test:private-development:local": "node scripts/postgres-integration.mjs private-development",
    "test:private-outline:local": "node scripts/postgres-integration.mjs private-outline"
  },
  "devDependencies": {
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2006",
    "turbo": "2.11.10"
  }
}
