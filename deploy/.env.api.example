# Combine these non-secret settings with deploy/.env in a protected local environment.
# The URL file must contain a restricted runtime LOGIN, never the initialization administrator.
CAMERY_TENANT_ID=
CAMERY_API_PORT=3000
CAMERY_API_DATABASE_SECRET_FILE=./secrets/api-database-url
# Set to 1 only after explicit ingest migration and additional least-privilege grants.
CAMERY_SOURCE_IMPORTS=0
