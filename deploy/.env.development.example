# Combine with private/API values. Every path refers to a runtime file, never a build argument.
CAMERY_DEVELOPMENT_PROJECT_ID=your-project
CAMERY_DEVELOPMENT_DATABASE_SECRET_FILE=./secrets/development-database-url
CAMERY_DEVELOPMENT_TASK_DATABASE_SECRET_FILE=./secrets/development-task-database-url
# Add compose.development-text.yml only after providing both files and the project budget.
CAMERY_DEVELOPMENT_TEXT_CONFIG_SECRET_FILE=./secrets/development-text-config.json
CAMERY_DEVELOPMENT_TEXT_TOKEN_SECRET_FILE=./secrets/development-text-token
CAMERY_DEVELOPMENT_WORKER_ID=development-worker
CAMERY_DEVELOPMENT_POLL_MS=1000
CAMERY_DEVELOPMENT_RUNS_PER_ROUND=20
