# Combine with existing private/API environment values. All paths are runtime files, never build args.
CAMERY_BIBLE_PROJECT_ID=your-project
CAMERY_BIBLE_DATABASE_SECRET_FILE=./secrets/bible-database-url
CAMERY_BIBLE_TASK_DATABASE_SECRET_FILE=./secrets/bible-task-database-url
# Add compose.bible-text.yml only after providing these files and a project budget.
CAMERY_BIBLE_TEXT_CONFIG_SECRET_FILE=./secrets/bible-text-config.json
CAMERY_BIBLE_TEXT_TOKEN_SECRET_FILE=./secrets/bible-text-token
CAMERY_BIBLE_WORKER_ID=bible-worker
